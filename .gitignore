# Python
__pycache__/
*.py[cod]
*.egg-info/
# Virtuelle Umgebung: liegt in .venv.nosync (iCloud synchronisiert *.nosync nicht), .venv ist ein Symlink darauf
.venv
.venv.nosync/
venv/
.pytest_cache/
.ruff_cache/
build/
dist/

